@echo off
chcp 65001 >nul
cd /d "%~dp0"
echo Включаю ежедневное обновление дашбордов в 08:30 (Планировщик заданий Windows, задача "Flowlink дашборды").
schtasks /Create /F /SC DAILY /ST 08:30 /TN "Flowlink дашборды" /TR "\"%~dp012 Обновить дашборды.bat\" /auto"
if errorlevel 1 (echo Не получилось создать задачу. Запустите этот файл правой кнопкой - "Запуск от имени администратора". & pause & exit /b 1)
echo.
echo Готово. Дашборды будут обновляться каждый день в 08:30, если компьютер включён,
echo и сразу после каждого прогона робота.
echo Отключить: schtasks /Delete /TN "Flowlink дашборды" /F
pause
